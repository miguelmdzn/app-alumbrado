{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "app-bitacora",
  "version": "0.1.0",
  "identifier": "com.v1.app-bitacora",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bitácora Diaria de Reportes",
        "url": "registros-reportes.html",
        "width": 1120,
        "height": 840,
        "minWidth": 850,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:alumbrado_publico.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
